# Use 127.0.0.1, not localhost, for Redis: on some Windows/Docker Desktop setups localhost resolves to ::1 and the connection is reset.
SERVICE_NAME=matchmaking-service
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://gaming_admin:change_me_local_only@localhost:27017/gaming?authSource=admin
MONGODB_DB_NAME=gaming
MONGODB_CONNECT_RETRIES=10
MONGODB_RETRY_DELAY_MS=2000
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_RETRIES=10
REDIS_RETRY_DELAY_MS=2000
