# Local-development credentials only. Change these in your local .env file.
MONGO_ROOT_USERNAME=gaming_admin
MONGO_ROOT_PASSWORD=change_me_local_only

NEO4J_AUTH=neo4j/change_me_local_only
# Password of the NEO4J_AUTH user above; the application container uses it to connect.
NEO4J_PASSWORD=change_me_local_only

# Ports published on the developer machine.
REDIS_PORT=6379
MONGO_PORT=27017
CASSANDRA_PORT=9042
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Application services.
GAMING_APP_PORT=3001
