# Credenciales solo para desarrollo local. Cambiarlas en tu archivo .env local.
MONGO_ROOT_USERNAME=gaming_admin
MONGO_ROOT_PASSWORD=change_me_local_only

NEO4J_AUTH=neo4j/change_me_local_only
# Contraseña del usuario de NEO4J_AUTH de arriba; el contenedor de la aplicación la usa para conectarse.
NEO4J_PASSWORD=change_me_local_only

# Puertos publicados en la máquina de desarrollo.
REDIS_PORT=6379
MONGO_PORT=27017
CASSANDRA_PORT=9042
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Servicios de la aplicación.
GAMING_APP_PORT=3001
