{
  "name": "gaming-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gaming platform application layer REST API",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "seed:history": "tsx --env-file=.env src/scripts/seedHistoryAndFraud.ts"
  },
  "dependencies": {
    "cassandra-driver": "4.8.0",
    "express": "5.3.0",
    "ioredis": "5.11.1",
    "mongodb": "7.7.0",
    "neo4j-driver": "6.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "6.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "packageManager": "pnpm@10.34.6",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
